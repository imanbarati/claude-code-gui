# Copy to .env and fill in if you prefer env-based config.
# The app primarily stores settings via electron-store in the Settings panel,
# so these are optional conveniences for development.

# Anthropic / Claude Code (optional; the CLI can also use `claude` login)
ANTHROPIC_API_KEY=

# OpenRouter free-tier key (used by the "openrouter" backend)
OPENROUTER_API_KEY=

# Ollama (defaults to localhost)
OLLAMA_URL=http://localhost:11434
