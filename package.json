{
  "name": "claude-code-gui",
  "version": "0.1.0",
  "description": "Free, easy-install GUI for Claude Code with agentic coding. Pick Claude Code CLI (your account) or free backends (Ollama / OpenRouter).",
  "license": "MIT",
  "author": "you",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:tools": "esbuild scripts/tools.test.mjs.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --outfile=out/tools.test.mjs --log-level=warning && node out/tools.test.mjs",
    "test:renderer": "esbuild scripts/renderer.test.mjs.ts --bundle --platform=node --format=esm --alias:@renderer=./src/renderer/src --outfile=out/renderer.test.mjs --log-level=warning && node out/renderer.test.mjs",
    "test:conv": "esbuild scripts/conv.test.mjs.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --outfile=out/conv.test.mjs --log-level=warning && node out/conv.test.mjs",
    "test:conn": "esbuild scripts/conn.test.mjs.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --external:electron --outfile=out/conn.test.mjs --log-level=warning && node out/conn.test.mjs",
    "test": "npm run test:tools && npm run test:renderer && npm run test:conv && npm run test:conn",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:portable": "electron-vite build && electron-builder --win portable --x64",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.example.claudecodegui",
    "productName": "Claude Code GUI",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
